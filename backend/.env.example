# AI Courtroom Simulator - Backend Environment Configuration

# Provider 1: Google Gemini (Recommended)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# Provider 2: OpenAI or OpenAI-compatible endpoint (Groq, OpenRouter, Ollama)
# Obtain from https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model selection (Optional override; defaults to gemini-2.5-flash or gpt-4o-mini)
LLM_MODEL=

# Server settings
HOST=0.0.0.0
PORT=8000
